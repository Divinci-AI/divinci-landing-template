---
/**
 * The full landing-page document, parameterized by `lang`. Rendered by
 * both src/pages/index.astro (en, at "/") and
 * src/pages/[lang]/index.astro (every other locale, at "/<code>/").
 *
 * Responsibilities:
 *   - <html lang dir> for the active locale (RTL-aware)
 *   - translated <head> meta (title/description/og/twitter)
 *   - hreflang alternates for all 36 locales + x-default (SEO)
 *   - return-visitor language preference (localStorage) from the root
 *   - passes `lang` into every section so they pull from the dictionary
 */
import "~/styles/global.css";
import { isDarkPalette, readableOn } from "~/lib/contrast";
import LanguageSwitcher from "~/components/LanguageSwitcher.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import HeroSection from "~/components/sections/HeroSection.astro";
import CorpusSection from "~/components/sections/CorpusSection.astro";
import TranscriptShowcase from "~/components/sections/TranscriptShowcase.astro";
import ExamplesSection from "~/components/sections/ExamplesSection.astro";
import ComingSoonSection from "~/components/sections/ComingSoonSection.astro";
import BiosSection from "~/components/sections/BiosSection.astro";
import CTASection from "~/components/sections/CTASection.astro";
import { getUI } from "~/i18n";
import {
  DEFAULT_LOCALE,
  LOCALES,
  dirFor,
} from "~/i18n/locales";
import { brand } from "~/brand.config";
import { OG_VERSION } from "~/og-version";

interface Props {
  lang?: string;
}
const { lang = DEFAULT_LOCALE } = Astro.props;
const m = getUI(lang).meta;
const dir = dirFor(lang);
const site = brand.identity.domain;

// Brand palette + font injected as :root overrides. The template's Tailwind
// @theme tokens (--color-df-*) carry the template defaults; this block overrides
// them with the customer's palette so every `bg-df-*`/`text-df-*` utility
// re-skins with zero component changes.
const p = brand.palette;

// DARK BRANDS.
//
// The semantic surface tokens in global.css default to the light values the
// components used to hardcode, so a light palette is untouched by everything
// below. A dark palette needs every one of them inverted at once: a white card
// with gray-500 text on dodcyberconsulting.com's #04090e body is not a styling
// blemish, it is a different website.
//
// Keyed on the PAGE colour, which is what `cream` means on both paths — the
// extractor sets it to the site's own background whatever its lightness.
const isDarkBrand = isDarkPalette(p.cream);
// Ink on the primary/accent chrome. `text-white` cannot ask this question, and
// on a cyan or pale-gold chrome white is the wrong answer.
// Candidates are white and the PAGE colour — never `text`, which on a dark
// brand is another light ink and so cannot rescue a pale chrome. On a light
// brand `cream` is near-white, so white keeps winning and nothing moves.
const onChrome = readableOn(p.dark, "#ffffff", p.cream);
const darkSurfaceVars = isDarkBrand
  ? `:root{` +
    // Panels sit ABOVE the page on a dark design: `soft` is already one step
    // up from `cream`, so the card surface is that, not white.
    `--color-df-surface:${p.soft};--color-df-surface-2:${p.cream};` +
    // Secondary text as the brand's own ink, dimmed — not a grey ramp, which
    // goes muddy against a saturated near-black.
    `--color-df-muted:color-mix(in srgb, ${p.text} 62%, ${p.cream});` +
    `--color-df-muted-strong:color-mix(in srgb, ${p.text} 82%, ${p.cream});` +
    `--color-df-faint:color-mix(in srgb, ${p.text} 45%, ${p.cream});` +
    `--color-df-line:color-mix(in srgb, ${p.text} 16%, ${p.cream});` +
    `--color-df-line-strong:color-mix(in srgb, ${p.text} 28%, ${p.cream});` +
    // `green-dark` is an INK token at several call sites (the corpus stat
    // numbers, the language-list label, the showcase byline) as well as a
    // chrome base. On a light brand `dark` is a deep colour and reads fine; on
    // a dark brand it can BE the page's near-black, so those numbers render
    // invisible on the card they sit on. Point the ink at the accent, which is
    // what a dark site does with its own counts.
    //
    // Only bites a hand-authored palette: the extractor's dark branch already
    // derives `dark` from the accent. Probed carried this as a local
    // Landing.astro override, which then froze it out of every later template
    // fix — the override is deleted with this commit.
    `--color-df-green-dark:${p.accent};` +
    `--color-df-on-chrome:${onChrome};` +
    // The frosted chat card. A white tint at 18% is a sheen on a light page
    // and a haze on a near-black one — it lightened dodcyber's card until
    // near-white body text stopped being readable, and its border drew a
    // white fringe around the panel. On a dark page the lift has to be a
    // fraction of that, and the hairline drawn in the brand's own ink.
    `--glass-tint-a:color-mix(in srgb, ${p.text} 7%, transparent);` +
    `--glass-tint-b:color-mix(in srgb, ${p.text} 4%, transparent);` +
    `--glass-border:color-mix(in srgb, ${p.text} 12%, transparent);` +
    // A black drop shadow is invisible on black; lift the card with a ring
    // of its own ink instead.
    `--glass-shadow:0 8px 32px color-mix(in srgb, ${p.cream} 60%, transparent);}`
  : `:root{--color-df-on-chrome:${onChrome};}`;

const brandVars = `:root{` +
  `--color-df-navy:${p.primary};--color-df-green-dark:${p.dark};` +
  `--color-df-green-mid:${p.mid};--color-df-green-leaf:${p.accent};` +
  `--color-df-cream:${p.cream};--color-df-cream-soft:${p.soft};` +
  `--color-df-bubble-user:${p.bubble};--color-df-text:${p.text};` +
  `--font-sans:${brand.fonts.family};` +
  // The brand's DISPLAY face, for the "AI" wordmark beside the logo. Falls back
  // to the body font, so a brand whose headings and body share a face is
  // unchanged. AuraPath is why this exists: its body is IBM Plex Sans and its
  // headings are Fraunces, so rendering "AI" in the body font put a heavy
  // grotesque next to a serif wordmark.
  `--font-display:${brand.fonts.display ?? brand.fonts.family};` +
  // The wordmark's full treatment. Each defaults to the CSS initial value, so a
  // brand that specified nothing renders exactly as before.
  `--font-display-style:${brand.fonts.displayStyle ?? "normal"};` +
  `--font-display-weight:${brand.fonts.displayWeight ?? "500"};` +
  `--font-display-tracking:${brand.fonts.displayLetterSpacing ?? "normal"};` +
  `--font-display-variation:${brand.fonts.displayVariationSettings ?? "normal"};` +
  `--logo-url:url("${brand.media.logo}");}` +
  darkSurfaceVars;

function urlFor(code: string): string {
  return code === DEFAULT_LOCALE ? `${site}/` : `${site}/${code}/`;
}
const canonical = urlFor(lang);

// og:image MUST be an absolute URL. The Open Graph spec requires it, X/Twitter
// rejects a relative value outright, and Slack/LinkedIn resolve it only
// inconsistently — so `content="/og.png"` was a preview that worked nowhere
// reliably. `site` is already absolute, so derive from it rather than asking
// each caller to remember.
// The card's CONTENT HASH is part of the URL. Slack, iMessage and LinkedIn
// cache the unfurl image keyed by URL, independently of page re-scrapes — so a
// fixed card is never shown while the URL stays `/og.png`. Re-scraping with
// ?v=2 made Slack report the new file size and still render the old image.
// A hash rather than a timestamp: an unchanged card keeps its URL and stays
// cached; only a card that really changed forces every consumer to re-fetch.
const ogImage = new URL(`/og.png?v=${OG_VERSION}`, `${site}/`).href;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={brand.media.favicon} />
    {/* Load the client's real webfont(s) so the brand font actually renders
        (otherwise the named family falls through to a fallback / UA serif). */}
    {brand.fonts.links && brand.fonts.links.length > 0 && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        {brand.fonts.links.map((href) => (
          <link rel="stylesheet" href={href} />
        ))}
      </>
    )}
    <style is:inline set:html={brandVars}></style>
    <title>{m.title}</title>
    <meta name="description" content={m.description} />
    <link rel="canonical" href={canonical} />

    {/* hreflang alternates — one per locale + x-default → English root */}
    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={l.code} href={urlFor(l.code)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={urlFor(DEFAULT_LOCALE)} />

    <meta property="og:site_name" content={brand.identity.siteName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={m.ogTitle} />
    <meta property="og:description" content={m.ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={m.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={m.twitterTitle} />
    <meta name="twitter:description" content={m.twitterDescription} />
    <meta name="twitter:image" content={ogImage} />

    {/* Return-visitor language preference: only auto-redirects FROM the
        English root to a previously-chosen non-English locale, so manual
        navigation to a specific /<code>/ is always respected. Runs before
        paint to avoid a flash. */}
    {
      lang === DEFAULT_LOCALE && (
        <script is:inline>
          {`(function(){try{var p=localStorage.getItem("df-lang");if(p&&p!=="en"&&location.pathname==="/"){location.replace("/"+p+"/");}}catch(e){}})();`}
        </script>
      )
    }
  </head>
  <body class="min-h-screen bg-df-surface text-df-text antialiased">
    <LanguageSwitcher lang={lang} />
    <Header lang={lang} />
    <main>
      <HeroSection lang={lang} />
      <CorpusSection lang={lang} />
      <TranscriptShowcase lang={lang} />
      {brand.sections?.examples !== false && <ExamplesSection lang={lang} />}
      {brand.sections?.comingSoon !== false && <ComingSoonSection lang={lang} />}
      {brand.sections?.bios !== false && <BiosSection lang={lang} />}
      <CTASection lang={lang} />
    </main>
    <Footer lang={lang} />
    <script>
      import { initHeroHashLinks } from "~/lib/scroll-to-hero";

      initHeroHashLinks();
    </script>
    <script>
      // Cursor-tracked aurora gradient on the body background.
      // RAF-throttled so we don't repaint more than once per frame.
      let mx = 0,
        my = 0,
        raf: number | null = null;
      function flush() {
        document.body.style.setProperty("--mouse-x", `${mx}px`);
        document.body.style.setProperty("--mouse-y", `${my}px`);
        raf = null;
      }
      window.addEventListener(
        "pointermove",
        (e) => {
          mx = e.clientX;
          my = e.clientY;
          if (raf === null) raf = requestAnimationFrame(flush);
        },
        { passive: true },
      );
    </script>
  </body>
</html>
