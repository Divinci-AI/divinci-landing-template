---
import { withRef } from "~/lib/links";
import { getUI } from "~/i18n";
import { DEFAULT_LOCALE } from "~/i18n/locales";
import { brand } from "~/brand.config";

interface Props {
  lang?: string;
}
const { lang = DEFAULT_LOCALE } = Astro.props;
const ui = getUI(lang);

const mainSiteLabel = brand.links.mainSite.replace(/^https?:\/\//, "").replace(/\/$/, "");
const navItems = [
  { href: "#hero", label: ui.nav.chat },
  { href: "#corpus", label: ui.nav.corpus },
  // Only link to sections that are actually rendered (see Landing.astro).
  ...(brand.sections?.examples !== false ? [{ href: "#examples", label: ui.nav.examples }] : []),
  ...(brand.sections?.comingSoon !== false ? [{ href: "#coming-soon", label: ui.nav.comingSoon }] : []),
  {
    href: withRef(brand.links.mainSite, "header-nav"),
    label: mainSiteLabel,
    external: true,
  },
];
---

<header
  id="site-header"
  class="header-hidden fixed inset-x-0 top-0 z-30 bg-df-navy/95 px-6 py-3 text-white shadow-sm backdrop-blur-md transition-all duration-300 ease-out"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between">
    {/* items-BASELINE, not items-end. items-end aligns the boxes' bottom
        edges, and a text box extends BELOW its baseline by the descender depth
        while a tightly-cropped logo's bottom edge IS its baseline. Aligning
        bottoms therefore pushes the logo down by exactly that gap — which is
        why the customer's logo sat visibly lower than "AI" on every demo.
        A flex item that is an image baselines on its bottom margin edge, so
        items-baseline lands the logo's foot on the text's baseline. */}
    <a href="#hero" class="flex items-baseline gap-1.5" aria-label={ui.header.logoAriaLabel}>
      <img
        src={brand.media.logo}
        alt={brand.identity.siteName}
        class="h-6 w-auto brightness-0 invert"
        width="200"
        height="42"
      />
      {/* inline-BLOCK, not inline-flex: an inline-flex box reports a baseline
          derived from its flex line, which items-center then shifts, so the
          baseline this span hands its parent would not be the "AI" glyphs'.
          That silently defeats the items-baseline above. */}
      <span class="relative inline-block">
        <span
          class="bg-gradient-to-br from-df-green-leaf via-df-green-leaf to-df-green-mid bg-clip-text text-lg font-extrabold leading-none tracking-tight text-transparent"
        >
          AI
        </span>
        <svg
          class="absolute -right-2 -top-1 h-2.5 w-2.5 text-df-green-leaf"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 2L13.4 9.6 21 12L13.4 14.4 12 22 10.6 14.4 3 12 10.6 9.6Z"
          ></path>
        </svg>
        <svg
          class="absolute -bottom-1 -left-1.5 h-2 w-2 text-df-green-mid"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 2L13.4 9.6 21 12L13.4 14.4 12 22 10.6 14.4 3 12 10.6 9.6Z"
          ></path>
        </svg>
      </span>
    </a>
    <div class="flex items-center gap-4">
      <nav class="hidden gap-6 text-sm md:flex">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="transition-colors hover:text-df-green-leaf"
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      {/* The desktop nav is `hidden md:flex`, so below md every link in the
          header was unreachable — no menu, no alternative, just a logo. This is
          the mobile half of the same nav, not a second source of links. */}
      <button
        id="nav-toggle"
        type="button"
        class="-mr-1 inline-flex items-center justify-center rounded-lg p-2 text-white transition-colors hover:bg-white/10 md:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        {/* Fallback, NOT a key in the neutral en.ts — deliberately.

            Every demo's per-customer copy is validated against that file's
            shape, and a generated file missing a key is rejected WHOLESALE:
            the run silently keeps the neutral copy, so the demo ships branded
            "Acme Expert AI" in its title, og:title, chat welcome and CTA.
            Adding `menuAriaLabel` there did exactly that to mach33, and it is
            the second time this class has reverted live demos.

            Rule: a new UI string gets a literal fallback in the component. Only
            add a key to the neutral en.ts alongside regenerating every demo's
            copy. */}
        aria-label={ui.header.menuAriaLabel ?? "Menu"}
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" hidden class="mx-auto mt-3 max-w-6xl flex-col gap-1 border-t border-white/10 pt-3 md:hidden">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="rounded-lg px-2 py-2.5 text-base transition-colors hover:bg-white/10 hover:text-df-green-leaf"
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style is:global>
  #site-header.header-hidden {
    transform: translateY(-110%);
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  // Mobile menu. `hidden` (the attribute) is the closed state so the links are
  // still in the DOM for crawlers and for anyone with JS off — for whom the
  // toggle simply never appears, rather than appearing and doing nothing.
  const navToggle = document.getElementById("nav-toggle");
  const mobileNav = document.getElementById("mobile-nav");
  if (navToggle && mobileNav) {
    const setOpen = (open: boolean) => {
      mobileNav.hidden = !open;
      mobileNav.classList.toggle("flex", open);
      navToggle.setAttribute("aria-expanded", String(open));
    };
    navToggle.addEventListener("click", () => setOpen(mobileNav.hidden));
    // Every link is an in-page anchor, so leaving the panel open would cover
    // the section the visitor just asked to see.
    mobileNav.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
    // Crossing the md breakpoint with the panel open leaves it stuck open
    // underneath the desktop nav.
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // Hide the header while the hero section is in view; reveal it once the
  // visitor scrolls past the hero.
  const header = document.getElementById("site-header");
  const hero = document.getElementById("hero");
  if (header && hero) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          header.classList.add("header-hidden");
        } else {
          header.classList.remove("header-hidden");
        }
      },
      { threshold: 0.05 },
    );
    observer.observe(hero);
  }
</script>
