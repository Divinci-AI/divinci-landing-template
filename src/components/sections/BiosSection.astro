---
import { getUI } from "~/i18n";
import { DEFAULT_LOCALE } from "~/i18n/locales";
import { withRef } from "~/lib/links";
import { brand } from "~/brand.config";

interface Props {
  lang?: string;
}
const { lang = DEFAULT_LOCALE } = Astro.props;
const t = getUI(lang).bios;

const creditLabel = brand.links.mainSite.replace(/^https?:\/\//, "").replace(/\/$/, "");
const creditUrl = withRef(brand.links.bioCreditUrl, "bios-credit");

// Bare, generic bio cards — one per entry in brand.config.bios (any number).
// Name comes from config; role + body come from the i18n `bios` dict by index.
// No portrait dependency: a simple initial-letter avatar keeps the foundation
// asset-free until the brand-kit process supplies real headshots.
//
// ⚠️ THE ROLE FALLBACK IS LOCALE-DEPENDENT, deliberately.
//
// `brand.config` has no localized form — there is one config for all 35
// languages. So falling back to `b.title` on a translated page renders ENGLISH
// text among the translation. EvoNexus shipped six cards reading "Team" in the
// middle of an otherwise fluent French page, and it looked exactly like a
// half-finished translation because that is what it was.
//
// On the default locale the config title is correct and useful, so keep it.
// Anywhere else, an untranslated role is worse than no role: the card still
// carries the person's name and photograph, which is the part that matters.
const isDefaultLocale = lang === DEFAULT_LOCALE;
const bios = brand.bios.map((b, i) => ({
  name: b.name,
  role: t.roles[i] ?? (isDefaultLocale ? b.title : ""),
  body: t.bodies[i] ?? "",
  image: b.image,
}));

function initials(name: string): string {
  return name
    .replace(/(Dr\.|Mr\.|Ms\.|Mrs\.|M\.D\.|PhD|,.*$)/g, "")
    .trim()
    .split(/\s+/)
    .map((w) => w[0])
    .filter(Boolean)
    .slice(0, 2)
    .join("")
    .toUpperCase();
}

// 1 bio → single centered card; 2+ → two-column grid.
const gridCols = bios.length === 1 ? "md:grid-cols-1 max-w-md mx-auto" : "md:grid-cols-2";
---

<section id="bios" class="bg-df-surface py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold text-df-text md:text-4xl">
        {t.headline}
      </h2>
      <p class="mt-4 text-lg text-df-muted-strong">
        {t.subheading}
      </p>
    </div>

    <div class={`mt-12 grid gap-8 ${gridCols}`}>
      {
        bios.map((bio) => (
          <article class="rounded-2xl bg-df-cream p-8 shadow-sm ring-1 ring-df-text/5">
            <div class="flex items-center gap-4">
              {/* Real headshot when the brand kit provides one (auto-sourced
                  from the prospect site); otherwise a clean initials avatar. */}
              {bio.image ? (
                <img
                  src={bio.image}
                  alt={bio.name}
                  class="h-14 w-14 shrink-0 rounded-full object-cover ring-1 ring-df-text/10"
                  width={56}
                  height={56}
                  loading="lazy"
                />
              ) : (
                <span
                  class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-df-green-dark text-lg font-bold text-df-on-chrome"
                  aria-hidden="true"
                >
                  {initials(bio.name)}
                </span>
              )}
              <div class="min-w-0">
                <h3 class="text-2xl font-bold leading-tight text-df-text [overflow-wrap:anywhere]">{bio.name}</h3>
                {bio.role && (
                  /* data-bio-role is a CONTRACT HOOK for the demo pipeline's
                     preflight, which compares the roles rendered on the default
                     page against a translated one to catch a localized bios
                     dictionary that is shorter than the team list. Selecting the
                     element by its styling instead was the first attempt and it
                     silently matched the card wrapper — name AND role — so both
                     pages read as non-empty and the check passed on a page that
                     was visibly wrong. Keep the attribute even if the classes
                     change. */
                  <p
                    data-bio-role
                    class="mt-1 text-sm font-medium uppercase tracking-wider text-df-green-dark"
                  >
                    {bio.role}
                  </p>
                )}
              </div>
            </div>
            {bio.body && (
              <p class="mt-4 text-base leading-relaxed text-df-muted-strong">
                {bio.body}
              </p>
            )}
          </article>
        ))
      }
    </div>

    <p class="mt-10 text-center text-sm text-df-muted">
      {t.footerPrefix}{" "}
      <a
        href={creditUrl}
        target="_blank"
        rel="noopener"
        class="font-medium text-df-green-dark hover:underline"
      >
        {creditLabel}
      </a>
      .
    </p>
  </div>
</section>
