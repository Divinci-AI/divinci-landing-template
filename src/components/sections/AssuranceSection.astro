---
/**
 * What we measured about this assistant, and what protects it.
 *
 * Renders NOTHING when a run supplies no `brand.assurance` — an unscored demo
 * must not imply it was scored. The red-team block is separately conditional:
 * the fleet is QA-scored but not red-teamed, so it stays absent until a run
 * actually carries results.
 *
 * Copy lives in `~/i18n/assurance-strings`, NOT in `ui/en.ts`. See that module
 * for why: a key added to the customer copy surface de-brands every
 * previously-generated demo on its next rebuild.
 */
import { brand } from "~/brand.config";
import { ASSURANCE_STRINGS as S } from "~/i18n/assurance-strings";

const qa = brand.assurance?.qa;
const rt = brand.assurance?.redTeam;
---

{(qa || rt) && (
  <section class="assurance" id="assurance" aria-labelledby="assurance-heading">
    <div class="inner">
      <h2 id="assurance-heading">{S.heading}</h2>
      <p class="intro">{S.intro}</p>

      {qa && (
        <div class="block">
          <h3>{S.qaHeading}</h3>
          <div class="figures">
            <div class="figure">
              <span class="value">{qa.scorePct}</span>
              <span class="label">{S.qaScoreLabel}</span>
            </div>
            {qa.correctnessPct && (
              <div class="figure">
                <span class="value">{qa.correctnessPct}</span>
                <span class="label">{S.qaCorrectnessLabel}</span>
              </div>
            )}
            <div class="figure">
              <span class="value">{qa.passed}/{qa.total}</span>
              <span class="label">{S.qaPassedLabel}</span>
            </div>
          </div>
          <p class="method">{S.qaMethod}</p>
        </div>
      )}

      {rt && (
        <div class="block">
          <h3>{S.redTeamHeading}</h3>
          <div class="figures">
            <div class="figure">
              <span class="value">{rt.passed}/{rt.total}</span>
              <span class="label">{S.redTeamPassLabel}</span>
            </div>
          </div>
          <p class="method">{S.redTeamMethod}</p>
        </div>
      )}

      <div class="block">
        <h3>{S.securityHeading}</h3>
        <ul class="protections">
          {S.protections.map((p) => (
            <li>
              <strong>{p.title}</strong>
              <span>{p.body}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}

<style>
  .assurance {
    background: var(--color-df-soft);
    color: var(--color-df-text);
    padding: clamp(3rem, 8vw, 5.5rem) 1.25rem;
  }
  .inner { max-width: 62rem; margin: 0 auto; }
  h2 {
    font-weight: var(--df-heading-weight, 600);
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    margin: 0 0 0.6rem;
  }
  .intro { margin: 0 0 2.5rem; max-width: 46rem; opacity: 0.85; line-height: 1.6; }
  .block { margin-bottom: 2.75rem; }
  .block:last-child { margin-bottom: 0; }
  h3 {
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.65;
    margin: 0 0 1rem;
  }
  .figures { display: flex; flex-wrap: wrap; gap: clamp(1.5rem, 5vw, 3.5rem); margin-bottom: 1.1rem; }
  .figure { display: flex; flex-direction: column; }
  .value {
    font-size: clamp(2rem, 5vw, 2.9rem);
    font-weight: 600;
    line-height: 1.05;
    color: var(--color-df-primary);
  }
  .label { font-size: 0.85rem; opacity: 0.7; margin-top: 0.3rem; }
  .method { margin: 0; max-width: 46rem; line-height: 1.65; opacity: 0.85; }
  .protections { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  /* Two columns only where there is room; a 400px phone keeps one. */
  @media (min-width: 46rem) {
    .protections { grid-template-columns: 1fr 1fr; gap: 1.4rem 2.5rem; }
  }
  .protections li { display: flex; flex-direction: column; gap: 0.25rem; }
  .protections strong { font-weight: 600; }
  .protections span { opacity: 0.82; line-height: 1.6; font-size: 0.95rem; }
</style>
