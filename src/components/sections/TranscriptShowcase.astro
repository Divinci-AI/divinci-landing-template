---
/**
 * Transcript showcase — ONE real conversation from the live assistant,
 * rendered as a single scrollable chat
 * window. The messages area scrolls; a decoy composer pinned at the bottom
 * scrolls the visitor up into the real hero chat to ask their own question.
 *
 * Answers carry lightweight inline markup so we can mirror the in-app
 * formatting without a markdown dependency:
 *   **bold**      → <strong>
 *   *italic*      → <em>
 *   [[n]]         → citation superscript; hovering/focusing shows the n-th
 *                   retrieved source's title (the "context" pop-up).
 *
 * The conversation is a real English product exchange; its PROSE is
 * translated via the `transcript` dictionary so the showcase reads in the
 * page locale. The inline markup (**bold**, *italic*, [[n]]) is preserved
 * across translations. Filenames (sources), book recommendations, and the
 * model string stay in English here.
 */
import { getUI } from "~/i18n";
import { cleanContextTitle } from "~/lib/clean-context-title";
import { brandInitials } from "~/lib/initials";
import { DEFAULT_LOCALE } from "~/i18n/locales";
import { brand } from "~/brand.config";

interface Props {
  lang?: string;
}
const { lang = DEFAULT_LOCALE } = Astro.props;
const t = getUI(lang).transcript;
const welcome = getUI(lang).chat.welcomeMessage;

interface Exchange {
  question: string;
  sources: string[];
  answer: string[]; // paragraphs in the inline-markup mini-syntax
  recommendation?: string;
}

type Seg =
  | { t: "text"; v: string }
  | { t: "b"; v: string }
  | { t: "i"; v: string }
  | { t: "cite"; n: number };

// Parse the mini-syntax into renderable segments. Non-nested by design.
function parseInline(s: string): Seg[] {
  const out: Seg[] = [];
  const re = /\*\*([^*]+)\*\*|\*([^*]+)\*|\[\[(\d+)\]\]/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(s)) !== null) {
    if (m.index > last) out.push({ t: "text", v: s.slice(last, m.index) });
    if (m[1] !== undefined) out.push({ t: "b", v: m[1] });
    else if (m[2] !== undefined) out.push({ t: "i", v: m[2] });
    else out.push({ t: "cite", n: Number(m[3]) });
    last = re.lastIndex;
  }
  if (last < s.length) out.push({ t: "text", v: s.slice(last) });
  return out;
}

function sourceIcon(name: string): string {
  const ext = name.split(".").pop()?.toLowerCase();
  if (ext === "txt") return "📑";
  if (ext === "html" || ext === "htm") return "🌐";
  return "📄";
}

const welcomeMessage = welcome;

// Non-translatable per-exchange data — retrieved-source filenames and the
// book recommendation — zipped by index with the translated question +
// answer paragraphs from the `transcript` dictionary.
// PLACEHOLDER showcase data — replace with a real exchange from the
// customer's own assistant (retrieved-source filenames + recommendations),
// zipped by index with the translated question + answer prose from the
// `transcript` dictionary.
const exchangeMeta: Array<{ sources: string[]; recommendation?: string }> = [
  {
    sources: [
      "getting-started-guide.pdf",
      "intro-talk-episode-1.txt",
      "knowledge-base-overview.html",
    ],
    recommendation: "Getting Started Guide",
  },
  {
    sources: [
      "about-us.html",
      "knowledge-base-overview.html",
      "core-offerings.pdf",
    ],
    recommendation: `About ${brand.identity.siteName}`,
  },
  {
    sources: [
      "beginner-basics.pdf",
      "intro-talk-episode-1.txt",
      "faq.html",
    ],
  },
];

// Brand-supplied sources win over the placeholders. Per-index so a brand can
// override one exchange and leave the rest — and a brand that supplies none
// renders exactly as before.
const exchanges: Exchange[] = exchangeMeta.map((meta, i) => ({
  question: t.questions[i],
  answer: t.answers[i],
  sources: brand.showcase?.sources?.[i] ?? meta.sources,
  recommendation: brand.showcase?.recommendations?.[i] ?? meta.recommendation,
}));

const ASSISTANT_MODEL = brand.identity.productName;

// Resolve a citation number to its source ("context") title for the tooltip.
function citeTitle(ex: Exchange, n: number): string {
  const raw = ex.sources[n - 1] ?? ex.sources[ex.sources.length - 1];
  return raw ? cleanContextTitle(raw) : `${brand.identity.siteName}'s knowledge base`;
}
---

<section id="transcripts" class="bg-df-surface py-20">
  <div class="mx-auto max-w-3xl px-6">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-df-text md:text-4xl">
        {t.heading}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-df-muted-strong">
        {t.subheading}
      </p>
    </div>

    {/* Single chat window: header · scrollable messages · decoy composer */}
    <div
      class="mt-10 overflow-hidden rounded-3xl border border-df-green-dark/15 bg-gradient-to-b from-df-green-leaf/10 to-df-surface shadow-lg ring-1 ring-df-text/5"
    >
      {/* Header */}
      <div
        class="flex items-center gap-2 border-b border-df-green-dark/10 bg-df-surface/70 px-5 py-3 backdrop-blur-sm"
      >
        <span
          class="flex h-7 w-7 items-center justify-center overflow-hidden rounded-full bg-df-green-leaf/20 ring-1 ring-df-green-dark/15"
        >
          {brand.media.logoIsMark ? (
            <img src={brand.media.logo} alt="" aria-hidden="true" class="h-4 w-4" width="16" height="16" />
          ) : (
            <span class="text-[10px] font-bold text-df-green-dark" aria-hidden="true">{brandInitials(brand.identity.siteName)}</span>
          )}
        </span>
        <span class="font-semibold text-df-green-dark">{brand.identity.productName}</span>
        <span class="ml-auto inline-flex items-center gap-1.5 text-xs text-df-muted">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-df-green-leaf opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-df-green-mid"></span>
          </span>
          {t.online}
        </span>
      </div>

      {/* Scrollable messages */}
      <div class="df-chat-scroll h-[26rem] space-y-5 overflow-y-auto px-4 py-5 md:h-[32rem] md:px-6">
        {/* Opening greeting */}
        <div class="flex items-start gap-2">
          <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center overflow-hidden rounded-full bg-df-green-leaf/20 ring-1 ring-df-green-dark/15">
            {brand.media.logoIsMark ? (
            <img src={brand.media.logo} alt="" aria-hidden="true" class="h-4 w-4" width="16" height="16" />
          ) : (
            <span class="text-[10px] font-bold text-df-green-dark" aria-hidden="true">{brandInitials(brand.identity.siteName)}</span>
          )}
          </span>
          <p class="max-w-[88%] rounded-2xl rounded-tl-sm bg-df-surface px-4 py-2.5 text-sm leading-relaxed text-df-text shadow-sm md:text-base">
            {welcomeMessage}
          </p>
        </div>

        {
          exchanges.map((ex) => (
            <>
              {/* User question */}
              <div class="flex justify-end">
                <p class="max-w-[88%] rounded-2xl rounded-br-sm bg-df-green-dark px-4 py-2.5 text-left text-sm font-medium text-df-on-chrome md:text-base">
                  {ex.question}
                </p>
              </div>

              {/* Retrieved sources — the context bubbles */}
              <div class="flex flex-wrap gap-1.5">
                {ex.sources.map((s) => (
                  <span class="inline-flex max-w-full items-center gap-1 rounded-md border border-df-green-dark/15 bg-df-surface/80 px-2 py-1 text-xs text-df-muted">
                    <span aria-hidden="true">{sourceIcon(s)}</span>
                    <span class="truncate">{cleanContextTitle(s)}</span>
                  </span>
                ))}
              </div>

              {/* Assistant answer */}
              <div class="flex items-start gap-2">
                <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center overflow-hidden rounded-full bg-df-green-leaf/20 ring-1 ring-df-green-dark/15">
                  {brand.media.logoIsMark ? (
            <img src={brand.media.logo} alt="" aria-hidden="true" class="h-4 w-4" width="16" height="16" />
          ) : (
            <span class="text-[10px] font-bold text-df-green-dark" aria-hidden="true">{brandInitials(brand.identity.siteName)}</span>
          )}
                </span>
                <div class="max-w-[88%]">
                  <div class="space-y-2 rounded-2xl rounded-tl-sm bg-df-green-leaf/15 px-4 py-3 text-sm leading-relaxed text-df-text md:text-base">
                    {ex.answer.map((para) => (
                      <p>
                        {parseInline(para).map((seg) =>
                          seg.t === "b" ? (
                            <strong class="font-semibold">{seg.v}</strong>
                          ) : seg.t === "i" ? (
                            <em>{seg.v}</em>
                          ) : seg.t === "cite" ? (
                            <sup
                              tabindex="0"
                              class="df-cite group relative ml-0.5 cursor-help rounded bg-df-green-leaf/45 px-1 py-0.5 text-[0.65em] font-semibold text-df-text ring-1 ring-df-green-dark/25 focus:outline-none focus-visible:ring-1 focus-visible:ring-df-green-dark"
                            >
                              {seg.n}
                              <span
                                role="tooltip"
                                class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-1.5 hidden w-max max-w-[15rem] -translate-x-1/2 whitespace-normal rounded-md bg-df-text px-2.5 py-1.5 text-left text-xs font-normal not-italic leading-snug text-white shadow-lg group-hover:block group-focus-within:block"
                              >
                                {citeTitle(ex, seg.n)}
                              </span>
                            </sup>
                          ) : (
                            seg.v
                          ),
                        )}
                      </p>
                    ))}
                  </div>
                  <p class="mt-1 text-[0.7rem] text-df-muted">
                    <span class="font-semibold text-df-green-dark">{t.assistantLabel}</span>
                    {" · "}
                    {ASSISTANT_MODEL}
                  </p>
                  {ex.recommendation && (
                    <span class="mt-2 inline-flex items-center gap-1.5 rounded-full border border-df-green-dark/20 bg-df-surface px-3 py-1 text-xs text-df-green-dark">
                      <span aria-hidden="true">💡</span>
                      {t.recommendationPrefix}
                      <span class="font-semibold">{ex.recommendation}</span>
                      <span aria-hidden="true">→</span>
                    </span>
                  )}
                </div>
              </div>
            </>
          ))
        }
      </div>

      {/* Decoy composer — clicking jumps to the real hero chat */}
      <div class="border-t border-df-green-dark/10 bg-df-surface/70 p-3 backdrop-blur-sm">
        <button
          type="button"
          id="df-transcript-cta"
          aria-label={t.composerAria}
          class="group flex w-full items-center gap-2 rounded-full border border-df-green-dark/20 bg-df-surface px-4 py-2.5 text-left transition hover:border-df-green-dark hover:shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-df-green-dark/40"
        >
          <span class="flex-1 truncate text-sm text-df-faint group-hover:text-df-muted">
            {t.composerPlaceholder}
          </span>
          <span
            aria-hidden="true"
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-df-green-dark/90 text-df-on-chrome transition group-hover:bg-df-green-mid"
          >
            {/* SOLID, not a 2px outline. At 16px in a 32px circle the stroked
                Lucide send reads as a thin sketch against the filled button —
                the same shape the og-card draws filled, so the two surfaces
                disagreed. A single filled path also removes the interior
                hairline the two-path outline leaves behind. */}
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 shrink-0">
              <path d="M2 21l21-9L2 3v7l15 2-15 2v7z"></path>
            </svg>
          </span>
        </button>
      </div>
    </div>

    <p class="mt-6 text-center text-xs text-df-faint">
      Real responses from the live {ASSISTANT_MODEL}
    </p>
  </div>
</section>

<script>
  import { scrollToHeroChat } from "~/lib/scroll-to-hero";

  // The decoy composer scrolls the visitor up into the real hero chat,
  // centered, and focuses the email field so they can start a message.
  const cta = document.getElementById("df-transcript-cta");
  cta?.addEventListener("click", () => {
    scrollToHeroChat({ focusEmail: true });
  });

  // Touch devices have no hover — tap a citation to toggle its tooltip.
  document.querySelectorAll<HTMLElement>(".df-cite").forEach((cite) => {
    cite.addEventListener("click", (e) => {
      e.preventDefault();
      cite.focus();
    });
  });

  import { placeBelow } from "~/lib/popover-placement";

  /**
   * Lift each tooltip out of the scroll container's clip.
   *
   * The transcript window scrolls, and an overflow other than `visible` clips
   * descendants on BOTH axes — so an `absolute bottom-full` tooltip on a line
   * near the top of the window is trimmed at its edge. It reads as "covered
   * up" and sends you hunting for a z-index; z-index cannot help, because
   * clipping ignores stacking order. The React chat solves this with a portal;
   * here the tooltip is moved to <body> once and positioned from the
   * citation's viewport rect each time it is shown.
   */
  document.querySelectorAll<HTMLElement>(".df-cite").forEach((cite) => {
    const tip = cite.querySelector<HTMLElement>("[role='tooltip']");
    if (!tip) return;
    document.body.appendChild(tip);
    tip.classList.remove("absolute", "bottom-full", "left-1/2", "-translate-x-1/2", "mb-1.5", "group-hover:block", "group-focus-within:block");
    tip.style.position = "fixed";
    tip.style.display = "none";
    tip.style.zIndex = "60";

    const place = () => {
      const a = cite.getBoundingClientRect();
      const t = tip.getBoundingClientRect();
      // Shared with the React chat's FloatingLayer — two copies of this rule
      // is how one of them stayed wrong after the other was fixed.
      const below = placeBelow(a.top, window.innerHeight - a.bottom, t.height, 8);
      tip.style.top = `${below ? a.bottom + 8 : a.top - 8 - t.height}px`;
      tip.style.left = `${Math.min(Math.max(8, a.left + a.width / 2 - t.width / 2), Math.max(8, window.innerWidth - t.width - 8))}px`;
    };
    const show = () => {
      tip.style.display = "block";
      place();
    };
    const hide = () => {
      tip.style.display = "none";
    };
    cite.addEventListener("mouseenter", show);
    cite.addEventListener("mouseleave", hide);
    cite.addEventListener("focus", show);
    cite.addEventListener("blur", hide);
    // Capture phase: the scroller is the transcript, not the window, and a
    // bubbling listener never sees a nested scroll.
    window.addEventListener("scroll", () => tip.style.display === "block" && place(), true);
    window.addEventListener("resize", () => tip.style.display === "block" && place());
  });
</script>

<style>
  /* Slim, on-brand scrollbar for the chat window. */
  .df-chat-scroll {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--color-df-green-dark) 35%, transparent) transparent;
  }
  .df-chat-scroll::-webkit-scrollbar {
    width: 8px;
  }
  .df-chat-scroll::-webkit-scrollbar-thumb {
    background-color: color-mix(in srgb, var(--color-df-green-dark) 30%, transparent);
    border-radius: 9999px;
  }
</style>
